{
  "name": "json-highlighter",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome extension that highlights JSON documents.",
  "type": "module",
  "scripts": {
    "build": "esbuild src/content.ts --bundle --format=iife --target=chrome120 --outfile=dist/content.js",
    "watch": "npm run build -- --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
