{
  "manifest_version": 3,
  "name": "JSON Highlighter",
  "version": "1.0.0",
  "description": "Formats and highlights JSON documents that Chrome opens.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_end"
    }
  ]
}
